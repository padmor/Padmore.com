# Copy this file to .env and fill in the values. Never commit .env.

# Neon owner connection string. Used only by migrations and admin scripts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Limited server role (app_server) for everyday server work. Never use the owner here.
DATABASE_SERVER_URL=postgresql://app_server:PASSWORD@HOST/DB?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://YOUR-PROJECT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-a-random-string-of-at-least-32-characters
NEON_AUTH_JWKS_URL=https://YOUR-PROJECT.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon Data API
NEON_DATA_API_URL=https://YOUR-PROJECT.apirest.REGION.aws.neon.tech/neondb/rest/v1

# Resend email (server side only)
RESEND_API_KEY=re_your_key

# The site's public address, used in emailed links. Use the real domain in production.
APP_URL=http://localhost:3000
